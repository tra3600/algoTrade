# Copier ce fichier en .env (ou exporter les variables) — ne jamais committer les vraies clés.
ALPACA_API_KEY=your_api_key
ALPACA_SECRET_KEY=your_secret_key
# true = compte de test (paper trading), false = argent réel
ALPACA_PAPER=true
# iex (gratuit) ou sip (abonnement payant)
ALPACA_DATA_FEED=iex
