# Cles API Alpaca (https://app.alpaca.markets > API Keys). NE JAMAIS les commiter.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = compte de test (paper trading), false = argent reel
ALPACA_PAPER=true
# true = le bot journalise ses decisions sans envoyer d'ordres
DRY_RUN=true

# Action a trader. Vide = selection automatique de l'action la plus echangee
SYMBOL=
MIN_PRICE=5
MAX_PRICE=500

# Strategie : croisement de moyennes mobiles sur bougies 1 minute
SHORT_WINDOW=9
LONG_WINDOW=21

# Risque
POSITION_FRACTION=0.10     # part du capital engagee par position
STOP_LOSS_PCT=0.01         # stop-loss a -1 %
TAKE_PROFIT_PCT=0.02       # prise de profit a +2 %
MAX_DAILY_LOSS_PCT=0.03    # arret du trading si -3 % sur la journee

INTERVAL_SECONDS=60
# iex (gratuit) ou sip (abonnement payant)
DATA_FEED=iex
